  <!-- TEMPLATE 1: MANITOBA SCRIP -->
  <Template Id="20001">
    <Name>* Simple Citations: Métis Scrip (Manitoba, 1870–1876)</Name>
    <Description>Designed for citing Manitoba Act scrip grants (1870-1876), organized by Library and Archives Canada under RG 15, Series D-II-8-a. Uses the Simplified Citations architecture.</Description>
    <Category>Simplified Citations for Genealogical Sources</Category>
    <Footnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt; ||&lt; [ClaimantName]&gt;&lt;, affidavit no. [AffidavitNumber]&gt;&lt;, [Parish]&gt;&lt;, [ScripType] scrip&gt;&lt;; vol. [Volume]&gt;&lt;, microfilm [Microfilm]&gt;&lt;. [Repository:Caps]&gt;&lt;?[Repository]|&lt; ([URL]&gt;&lt;? [URL]|&lt;: accessed [Accessed]&gt;&gt;&lt;?[URL]|)&gt;.&gt;&gt;&lt; [RefNumber:Caps].&gt;</Footnote>
    <ShortFootnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription]&lt;: [ClaimantName]&lt;, aff. no. [AffidavitNumber]&gt;&gt;.|&lt;: [ClaimantName].&gt;&gt;</ShortFootnote>
    <Bibliography>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt;&lt; [Repository].&gt;</Bibliography>
    
    <Field>
      <Type>Name</Type>
      <Name>PrimaryCreator</Name>
      <Display>Primary Creator</Display>
      <Hint>e.g., Department of the Interior</Hint>
      <Detail>False</Detail>
      <LongHint>The overarching government department or ministry.</LongHint>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Department</Name>
      <Display>Dept. / Commission</Display>
      <Hint>e.g., Manitoba Scrip Commission</Hint>
      <Detail>False</Detail>
      <LongHint>The name of the overarching commission granting the scrip.</LongHint>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>Date</Name>
      <Display>Date Range</Display>
      <Hint>e.g., 1870–1876</Hint>
      <Detail>False</Detail>
      <LongHint>The operational date range of the commission.</LongHint>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>SourceDescription</Name>
      <Display>Source Description</Display>
      <Hint>e.g., Manitoba Métis Scrip Applications</Hint>
      <Detail>False</Detail>
      <LongHint>Title of the record collection on LAC.</LongHint>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Collection</Name>
      <Display>Collection / Series</Display>
      <Hint>e.g., Department of the Interior fonds, RG 15, Series D-II-8-a</Hint>
      <Detail>False</Detail>
      <LongHint>Archival fonds and series classification.</LongHint>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Repository</Name>
      <Display>Repository</Display>
      <Hint>e.g., Library and Archives Canada, Ottawa, Ontario</Hint>
      <Detail>False</Detail>
      <LongHint>Archival institution holding the records.</LongHint>
    </Field>
    <Field>
      <Type>Name</Type>
      <Name>ClaimantName</Name>
      <Display>Claimant Name</Display>
      <Hint>Name of the scrip applicant</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>AffidavitNumber</Name>
      <Display>Affidavit Number</Display>
      <Hint>e.g., 1234</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Place</Type>
      <Name>Parish</Name>
      <Display>Parish / Location</Display>
      <Hint>e.g., St. Francois Xavier</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>ScripType</Name>
      <Display>Scrip Type (Land/Money)</Display>
      <Hint>e.g., Land (160 acres), Land (240 acres), Money ($160)</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Volume</Name>
      <Display>Volume</Display>
      <Hint>e.g., 1320</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Microfilm</Name>
      <Display>Microfilm</Display>
      <Hint>e.g., C-14929</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>URL</Name>
      <Display>URL</Display>
      <Hint>Link to the LAC digital record</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>Accessed</Name>
      <Display>Date Accessed</Display>
      <Hint>e.g., 3 Aug 2026</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>RefNumber</Name>
      <Display>Reference / Item ID</Display>
      <Hint>e.g., Item ID 1502188</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
  </Template>

