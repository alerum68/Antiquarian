  <!-- TEMPLATE 5: DOMINION LAND GRANT / PATENT -->
  <Template Id="20005">
    <Name>* Simple Citations: Dominion Land Grants &amp; Patents</Name>
    <Description>Designed for citing final Letters Patent issued by the dominion government, utilizing the Dominion Lands System (Section, Township, Range, Meridian) and Liber/Folio identifiers. Uses the Simplified Citations architecture.</Description>
    <Category>Simplified Citations for Genealogical Sources</Category>
    <Footnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt; ||&lt; [GranteeName]&gt;&lt;?[OriginalClaimant]| (assignee of [OriginalClaimant])|&gt;&lt;, land grant, [LandDescription]&gt;&lt;, issued [IssueDate]&gt;&lt;; liber [Liber], folio [Folio]&gt;&lt;, microfilm [Microfilm]&gt;&lt;. [Repository:Caps]&gt;&lt;?[Repository]|&lt; ([URL]&gt;&lt;? [URL]|&lt;: accessed [Accessed]&gt;&gt;&lt;?[URL]|)&gt;.&gt;&gt;&lt; [RefNumber:Caps].&gt;</Footnote>
    <ShortFootnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription]&lt;: [GranteeName]&lt;, liber [Liber], folio [Folio]&gt;&gt;.|&lt;: [GranteeName].&gt;&gt;</ShortFootnote>
    <Bibliography>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt;&lt; [Repository].&gt;</Bibliography>
    
    <Field>
      <Type>Name</Type>
      <Name>PrimaryCreator</Name>
      <Display>Primary Creator</Display>
      <Hint>e.g., Department of the Interior</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Department</Name>
      <Display>Dept. / Branch</Display>
      <Hint>e.g., Dominion Lands Branch</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>Date</Name>
      <Display>Date Range</Display>
      <Hint>e.g., 1870–1930</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>SourceDescription</Name>
      <Display>Source Description</Display>
      <Hint>e.g., Dominion Lands Patents</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Collection</Name>
      <Display>Collection / Series</Display>
      <Hint>e.g., Dominion Land Grants, RG 15</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Repository</Name>
      <Display>Repository</Display>
      <Hint>e.g., Library and Archives Canada, Ottawa, Ontario</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Name</Type>
      <Name>GranteeName</Name>
      <Display>Grantee Name</Display>
      <Hint>The person receiving the patent</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Name</Type>
      <Name>OriginalClaimant</Name>
      <Display>Original Scrip Claimant</Display>
      <Hint>Leave blank if Grantee is the Métis claimant</Hint>
      <Detail>True</Detail>
      <LongHint>Often, Métis scrip was assigned or sold. Use this to link the final land patent back to the original Métis claimant.</LongHint>
    </Field>
    <Field>
      <Type>Place</Type>
      <Name>LandDescription</Name>
      <Display>Legal Land Description</Display>
      <Hint>e.g., NW part of Sec 14, Twp 5, Rge 3, W1</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>IssueDate</Name>
      <Display>Issue Date</Display>
      <Hint/>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Liber</Name>
      <Display>Liber (Book)</Display>
      <Hint>e.g., 42</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Folio</Name>
      <Display>Folio (Page)</Display>
      <Hint>e.g., 108</Hint>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>Microfilm</Name>
      <Display>Microfilm</Display>
      <Hint/>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>URL</Name>
      <Display>URL</Display>
      <Hint/>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>Accessed</Name>
      <Display>Date Accessed</Display>
      <Hint/>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>RefNumber</Name>
      <Display>Reference / Item ID</Display>
      <Hint/>
      <Detail>True</Detail>
      <LongHint/>
    </Field>
  </Template>

