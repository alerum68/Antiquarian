  <!-- TEMPLATE 4: SCRIP CERTIFICATE -->
  <Template Id="20004">
    <Name>* Simple Citations: Métis Scrip (Certificates &amp; Payments)</Name>
    <Description>Designed for citing the physical scrip certificates or receipts issued to the claimant, organized under LAC RG 15 Series D-II-8-e, D-II-8-f, or D-II-8-j. Uses the Simplified Citations architecture.</Description>
    <Category>Simplified Citations for Genealogical Sources</Category>
    <Footnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt; ||&lt; [ClaimantName]&gt;&lt;, [ScripType] scrip certificate no. [CertificateNumber]&gt;&lt; for [Amount]&gt;&lt;, issued [IssueDate]&gt;&lt;; vol. [Volume]&gt;&lt;, microfilm [Microfilm]&gt;&lt;. [Repository:Caps]&gt;&lt;?[Repository]|&lt; ([URL]&gt;&lt;? [URL]|&lt;: accessed [Accessed]&gt;&gt;&lt;?[URL]|)&gt;.&gt;&gt;&lt; [RefNumber:Caps].&gt;</Footnote>
    <ShortFootnote>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription]&lt;: [ClaimantName]&lt;, cert. no. [CertificateNumber]&gt;&gt;.|&lt;: [ClaimantName].&gt;&gt;</ShortFootnote>
    <Bibliography>&lt;[PrimaryCreator]&lt;,  [Department]&gt;&gt;&lt; ([Date])&gt;. &lt;?[SourceDescription]|[SourceDescription].|&gt;&lt;?[Collection]| [Collection].&gt;&lt; [Repository].&gt;</Bibliography>
    
    <Field>
      <Type>Name</Type>
      <Name>PrimaryCreator</Name>
      <Display>Primary Creator</Display>
      <Hint>e.g., Department of the Interior</Hint>
      <Detail>False</Detail>
      <LongHint/>
