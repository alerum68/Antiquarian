      <Name>Department</Name>
      <Display>Dept. / Commission</Display>
      <Hint>e.g., Scrip Commission</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Date</Type>
      <Name>Date</Name>
      <Display>Date Range</Display>
      <Hint>e.g., 1870–1906</Hint>
      <Detail>False</Detail>
      <LongHint/>
    </Field>
    <Field>
      <Type>Text</Type>
      <Name>SourceDescription</Name>
      <Display>Source Description</Display>
      <Hint>e.g., Métis Scrip Certificates and Payments</Hint>
